[node name="MissionManager" type="Node" parent="." unique_id=1293419208]
script = ExtResource("5_mission")
intro_title = "NIVEL 3: LA RAÍZ"
intro_text = "Dos criaturas, un mismo cuerpo: el murciélago VE y el Eco OYE, y se avisan. La RAÍZ late y delata tu posición. Para conseguir el hacha tendrás que bajar a la cámara inundada, girar 3 válvulas y no caer al agua. RUTA FÁCIL: corta la barrera del túnel noreste y escapa. RUTA DIFÍCIL: baja al corazón de la raíz, destrúyelo a hachazos, quema todo con 2 bidones y sal antes de que el fuego te alcance."
profile = "raiz"


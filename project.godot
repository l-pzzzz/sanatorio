; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sanatorio"
run/main_scene="res://scenes/menu_principal.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

driver/enable_input=true

[autoload]

Lang="*res://scripts/systems/lang.gd"
Difficulty="*uid://b2rh3vcmlviy1"
NoiseManager="*uid://5fmjjcsbdjna"
DisplayManager="*uid://cvv5u1gonlep1"
Net="*res://scripts/systems/net.gd"
SaveSystem="*res://scripts/systems/save_system.gd"
PauseMenu="*res://scripts/systems/pause_menu.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

